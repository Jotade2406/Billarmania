{
  "expo": {
    "name": "Billarmania",
    "slug": "billarmania-cliente",
    "sdkVersion": "54.0.0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "billarmania",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e293b",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Billarmania necesita acceso a tus fotos para subir el comprobante de pago.",
          "cameraPermission": "Billarmania necesita la cámara para tomar foto del comprobante."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
