# ─────────────────────────────────────────────────────────────
# BILLARMANIA — Plantilla de variables de entorno
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas .env a Git — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Supabase PostgreSQL) ──
# La encuentras en: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_REF].supabase.co:5432/postgres"

# ── Supabase (para Storage de imágenes) ──
# La encuentras en: Supabase Dashboard → Settings → API
SUPABASE_URL="https://[TU_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[TU_SERVICE_ROLE_KEY]"

# ── Auth JWT ──
# Genera un string largo y aleatorio (mínimo 32 chars)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# ── Redis (Upstash) — se configura en Fase 1 ──
# La encuentras en: Upstash Console → tu base Redis → REST API
UPSTASH_REDIS_REST_URL="https://[TU_ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[TU_TOKEN]"

# ── App ──
PORT=3000
NODE_ENV=development
