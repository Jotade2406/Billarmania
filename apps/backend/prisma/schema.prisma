generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────── ENUMS ────────────────────────

enum Role {
  CLIENTE
  CAJERO
  DUENO
  SUPER_ADMIN
}

enum TableStatus {
  LIBRE
  OCUPADA
  RESERVADA
  FUERA_DE_SERVICIO
}

enum ReservationStatus {
  PENDIENTE_PAGO
  EN_REVISION
  CONFIRMADA
  ACTIVA
  CANCELADA
  COMPLETADA
}

enum PaymentStatus {
  PENDIENTE
  VERIFICADO
  RECHAZADO
  REEMBOLSADO
  CONVERTIDO_A_CREDITO
}

enum PaymentMethodType {
  QR_BANCARIO
  TIGO_MONEY
  BILLETERA
  OTRO
}

// ──────────────────────── MODELOS ────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?
  role         Role    @default(CLIENTE)

  staffBranchId String?
  staffBranch   Branch? @relation("BranchStaff", fields: [staffBranchId], references: [id])

  ownedChains      Chain[]   @relation("ChainOwner")
  reservations     Reservation[]
  reviewedPayments Payment[] @relation("PaymentReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chain {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  ownerId  String
  owner    User     @relation("ChainOwner", fields: [ownerId], references: [id])
  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id      String  @id @default(cuid())
  chainId String
  chain   Chain   @relation(fields: [chainId], references: [id])

  name      String
  address   String?
  latitude  Float?
  longitude Float?
  openTime  String?
  closeTime String?

  depositAmount           Decimal @default(20) @db.Decimal(10, 2)
  reservationGraceMinutes Int     @default(5)
  confirmationTimeoutMin  Int     @default(10)
  refundCutoffHours       Int     @default(2)

  tables         Table[]
  reservations   Reservation[]
  paymentMethods PaymentMethod[]
  staff          User[]          @relation("BranchStaff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId])
}

model Table {
  id       String      @id @default(cuid())
  branchId String
  branch   Branch      @relation(fields: [branchId], references: [id])

  label      String
  status     TableStatus @default(LIBRE)
  hourlyRate Decimal?    @db.Decimal(10, 2)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([branchId, status])
}

model Reservation {
  id       String            @id @default(cuid())
  tableId  String
  table    Table             @relation(fields: [tableId], references: [id])
  branchId String
  branch   Branch            @relation(fields: [branchId], references: [id])
  userId   String
  user     User              @relation(fields: [userId], references: [id])

  status ReservationStatus @default(PENDIENTE_PAGO)

  reservedFor          DateTime
  deadline             DateTime?
  confirmationDeadline DateTime?
  depositAmount        Decimal   @db.Decimal(10, 2)

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([tableId])
  @@index([deadline])
  @@index([confirmationDeadline])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id])

  methodId String?
  method   PaymentMethod? @relation(fields: [methodId], references: [id])

  amount   Decimal       @db.Decimal(10, 2)
  status   PaymentStatus @default(PENDIENTE)
  proofUrl String?

  reviewedById String?
  reviewedBy   User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  type        PaymentMethodType
  displayName String
  qrImageUrl  String?
  accountInfo String?
  isActive    Boolean           @default(true)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}
